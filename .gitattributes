# Normalise line endings. Force LF for everything consumed on Linux / inside
# containers so the deployment ZIP works regardless of the checkout platform.
* text=auto

*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
*.env         text eol=lf
.env.example  text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf

# Binary assets — never touch.
*.ttf binary
*.png binary
*.pdf binary
*.zip binary
