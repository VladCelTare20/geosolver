+use super::*;
+use crate::lincomb::LinComb;
+use crate::proof::{FactId, ProofLog};
+
+impl Ddar {
+    pub fn p_log(&self) -> &ProofLog {
+        &self.log
+    }
+    pub fn p_angle_rows(&self) -> &[(FactId, LinComb)] {
+        &self.angle.core.fact_rows
+    }
+    pub fn p_dmul_rows(&self) -> &[(FactId, LinComb)] {
+        &self.dmul.core.fact_rows
+    }
+    pub fn p_names(&self) -> &[String] {
+        &self.names
+    }
+    pub fn p_n(&self) -> usize {
+        self.n
+    }
+    pub fn p_dir(&self, a: PointId, b: PointId) -> Option<LinComb> {
+        self.pair_dir[self.pk(a, b)].as_ref().map(|x| x.0.clone())
+    }
+    pub fn p_dm(&self, a: PointId, b: PointId) -> Option<LinComb> {
+        self.pair_dist_mul[self.pk(a, b)].as_ref().map(|x| x.0.clone())
+    }
+    pub fn p_lines(&self) -> Vec<(Vec<PointId>, Option<FactId>)> {
+        self.live_lines.iter().map(|&l| (self.lines[l].points.clone(), self.lines[l].fact)).collect()
+    }
+    pub fn p_circles(&self) -> Vec<(Vec<PointId>, Vec<PointId>, Option<FactId>)> {
+        self.live_circles
+            .iter()
+            .map(|&c| (self.circles[c].points.clone(), self.circles[c].centers.clone(), self.circles[c].fact))
+            .collect()
+    }
+    pub fn p_coord(&self, p: PointId) -> (f64, f64) {
+        let c = self.coords[p as usize];
+        (c.x, c.y)
+    }
+    pub fn p_subst(&self, p: PointId) -> PointId {
+        self.subst[p as usize]
+    }
+    pub fn p_pred_angle(&self, pred: &crate::predicate::Predicate) -> LinComb {
+        let pts = self.subst_points(pred);
+        self.pred_to_angle(&pred.name, &pts, &pred.constants).0
+    }
+    pub fn p_pred_dm(&mut self, pred: &crate::predicate::Predicate) -> LinComb {
+        let pts = self.subst_points(pred);
+        self.pred_to_dist_mul_raw(&pred.name, &pts, &pred.constants).0
+    }
+    pub fn p_angle_value(&self, c: &LinComb) -> f64 {
+        self.angle.core.value_of(c)
+    }
+}
