# Caddy in front of a native `agstudio serve` on 127.0.0.1:8787 (option C of
# DEPLOY.md). Caddy gets and renews the Let's Encrypt certificate by itself
# (ports 80 and 443 must reach it) and sets X-Forwarded-For to the real peer,
# replacing any value a client sent.
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile   # replace geo.example.com
#   sudo systemctl reload caddy
# The app needs, in /etc/agstudio.env:
#   AGSTUDIO_PUBLIC_HOST=geo.example.com  AGSTUDIO_TRUST_PROXY=1  AGSTUDIO_SECURE_COOKIES=1

geo.example.com {
	encode gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy 127.0.0.1:8787 {
		transport http {
			read_timeout 240s
			write_timeout 240s
		}
	}
}
