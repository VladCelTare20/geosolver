# Copy to deploy/.env (compose) or /etc/agstudio.env (systemd), owner-only:
#   install -m 600 deploy/.env.example deploy/.env
#   sudo install -m 600 -o root -g root deploy/.env.example /etc/agstudio.env
# then edit it. Every variable is documented in deploy/DEPLOY.md.
# To set a variable, delete the leading "# " of its line. Comments stay on their
# own lines: systemd's EnvironmentFile keeps a trailing "# ..." in the value.

# REQUIRED for any non-loopback / public deployment — the app refuses to start on
# a public interface without it, and refuses a password under 8 characters or
# one that still contains CHANGE-ME.
#   user:pass  -> both checked
#   :pass      -> any user name, this password ("share a link + a password")
# Generate one in a shell:  openssl rand -hex 16   then uncomment the line and
# paste that output in place of the CHANGE-ME placeholder (an env file does not
# run `$(...)`: written here, the command itself would be the password).
# AGSTUDIO_BASIC_AUTH=:CHANGE-ME-run-openssl-rand-hex-16
#
# Secrets may come from files instead (Docker/compose secrets, systemd
# LoadCredential) so they stay out of `docker inspect`; set one form, not both:
# AGSTUDIO_BASIC_AUTH_FILE=/run/secrets/agstudio_basic_auth
# AGSTUDIO_GATE_KEY_FILE=/run/secrets/agstudio_gate_key
# CLAUDE_CODE_OAUTH_TOKEN_FILE=/run/secrets/claude_oauth_token

# The public hostname(s) the app is served as. REQUIRED behind a proxy: on a
# loopback bind (systemd, NixOS) the Host check refuses every proxied request
# with 403 "unknown host" without it; in Docker (bind 0.0.0.0) the Host check
# is off without it.
# AGSTUDIO_PUBLIC_HOST=geo.example.com

# Behind your own TLS proxy (native binary + nginx/Caddy) also set these two;
# docker-compose.yml already sets them for its nginx.
# AGSTUDIO_TRUST_PROXY=1
# AGSTUDIO_SECURE_COOKIES=1

# ---- AI: Describe / Photo / explanations -----------------------------------
# Needs the `claude` CLI (Docker: GEOSOLVER_TARGET=ai) and a subscription token
# from `claude setup-token` (run once on any machine with a browser).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...
# Without them the app works for typed .geo problems; to switch the AI off
# explicitly:
# AGSTUDIO_DISABLE_TRANSLATE=1

# ---- docker compose only (read by compose, not by the app) -----------------
## `ai` = image with the claude CLI
# GEOSOLVER_TARGET=runtime
## container CPU limit; also sets the slot count
# GEOSOLVER_CPUS=2
## >= slots x AGSTUDIO_WORKER_MEM_MB + 300 MB
# GEOSOLVER_MEM_LIMIT=5g
## commit shown by /api/status (git rev-parse --short=12 HEAD)
# GEOSOLVER_REVISION=
## compile parallelism of the image build (empty = all cores)
# GEOSOLVER_BUILD_JOBS=
## claude CLI in the `ai` image (empty = the Dockerfile's pin)
# CLAUDE_CODE_VERSION=

# ---- optional tuning (defaults shown) --------------------------------------
# Flags take 1/0, true/false, yes/no or on/off (any case); any other value, or
# a number that does not parse, refuses to start.
## default on with a password: no account needed
# AGSTUDIO_GUEST_MODE=1
## 0 = Describe/Photo for accounts only
# AGSTUDIO_GUEST_AI=1
## per-IP AI calls per 24 h, guests and accounts (0 = no cap; default 60 with
## guest mode, else 0)
# AGSTUDIO_GUEST_AI_PER_DAY=60
## server-wide AI calls per 24 h (0 = no cap)
# AGSTUDIO_AI_PER_DAY_TOTAL=0
## basic = HTTP Basic dialog only
# AGSTUDIO_GATE=form
## how long a device stays signed in
# AGSTUDIO_GATE_DAYS=180
## 64 hex chars; default: generated, kept in the DB
# AGSTUDIO_GATE_KEY=
# AGSTUDIO_BASIC_AUTH_FAILS_PER_MIN=10
## default min(max(CPUs, 2), 8); one solve worker each
# AGSTUDIO_MAX_CONCURRENT=
## wait for a free slot before 503 + Retry-After
# AGSTUDIO_QUEUE_WAIT_SECS=5
## RLIMIT_DATA (committed memory) per solve worker (0 = none)
# AGSTUDIO_WORKER_MEM_MB=2048
## 0 = no human-style proof (full derivation only)
# AGSTUDIO_HUMAN_PROOFS=1
## per-IP /api requests per minute (0 = off)
# AGSTUDIO_RATE_PER_MIN=120
## per-IP translations + explanations per minute
# AGSTUDIO_TRANSLATE_PER_MIN=12
## per-IP login/register per minute
# AGSTUDIO_AUTH_PER_MIN=15
## request body limit
# AGSTUDIO_MAX_BODY_KB=8192
## max program length
# AGSTUDIO_MAX_INPUT_CHARS=16384
