# Copy to deploy/.env and edit before deploying.

# REQUIRED for any non-loopback / public deployment — the app refuses to start on
# a public interface without it, and refuses a password under 8 characters.
#   user:pass  -> both checked
#   :pass      -> any user name, this password ("share a link + a password")
# Generate one:  openssl rand -hex 16
AGSTUDIO_BASIC_AUTH=:CHANGE-ME-run-openssl-rand-hex-16

# The public hostname(s) the app is served as (needed for the Host check).
# AGSTUDIO_PUBLIC_HOST=geo.example.com

# ---- optional tuning (defaults shown) --------------------------------------
# AGSTUDIO_GUEST_MODE=1           # default on with Basic auth: no account needed
# AGSTUDIO_BASIC_AUTH_FAILS_PER_MIN=10
# AGSTUDIO_MAX_CONCURRENT=4        # simultaneous heavy requests; one solve worker process each
# AGSTUDIO_QUEUE_WAIT_SECS=5       # wait for a free slot before 503 + Retry-After
# AGSTUDIO_WORKER_MEM_MB=2048      # address-space cap per solve worker (0 = none)
# AGSTUDIO_HUMAN_PROOFS=1         # 0 = no human-style proof (full derivation only)
# AGSTUDIO_RATE_PER_MIN=120        # per-IP /api requests per minute (0 = off)
# AGSTUDIO_TRANSLATE_PER_MIN=12    # per-IP photo/text translations per minute
# AGSTUDIO_MAX_BODY_KB=8192        # request body limit
# AGSTUDIO_MAX_INPUT_CHARS=16384   # max program length

# Photo / natural-language translation needs the `claude` CLI (signed into a
# Claude subscription) inside the container — it is not installed by default, so
# translation is simply off and the app works for typed .geo problems. To turn
# the endpoint off explicitly:
# AGSTUDIO_DISABLE_TRANSLATE=1
