# Native (non-Docker) systemd unit. Install:
#   ./deploy/build-linux.sh
#   sudo install -Dm755 target/release/agstudio /opt/agstudio/agstudio
#   sudo cp deploy/agstudio.service /etc/systemd/system/
#   sudo install -m 600 -o root -g root deploy/.env.example /etc/agstudio.env   # then edit it
#   sudo systemctl daemon-reload && sudo systemctl enable --now agstudio
[Unit]
Description=GeoSolver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/agstudio/agstudio serve
EnvironmentFile=/etc/agstudio.env
# Accounts, sessions and history live in SQLite. DynamicUser + ProtectSystem=strict
# leave no writable path except the StateDirectory, so the DB must live there.
StateDirectory=agstudio
StateDirectoryMode=0700
WorkingDirectory=/var/lib/agstudio
Environment=AGSTUDIO_DB=/var/lib/agstudio/agstudio.db
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Run as a dedicated, unprivileged, dynamically-allocated user.
DynamicUser=yes
# Sandboxing / hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# Photo/NL translation and AI explanations (deploy/DEPLOY.md, "AI on a server"):
# install the `claude` CLI, put CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`)
# and AGSTUDIO_CLAUDE_BIN=<absolute path to claude> in /etc/agstudio.env, and
# override (systemctl edit agstudio):
#   [Service]
#   MemoryDenyWriteExecute=no
#   Environment=HOME=/var/lib/agstudio CLAUDE_CONFIG_DIR=/var/lib/agstudio/claude DISABLE_AUTOUPDATER=1
# The CLI's JIT needs writable+executable memory, and it keeps its state under
# HOME, which must be inside the StateDirectory.

[Install]
WantedBy=multi-user.target
